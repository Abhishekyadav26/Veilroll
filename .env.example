# Copy to .env.local and fill in. Never commit .env.local.

# mock (default: no funds, no network) | oneclick (live NEAR Intents)
NEXT_PUBLIC_SETTLEMENT=mock

# NEAR network used for wallet + NEP-413 verification: testnet | mainnet
NEXT_PUBLIC_NEAR_NETWORK=testnet

# Optional: override the public RPC used for reads and signature checks.
# NEXT_PUBLIC_NEAR_RPC=https://rpc.testnet.fastnear.com

# Partner JWT from https://partners.near-intents.org
# Required only for confidential quotes (confidentiality: basic | advanced).
# Without it, 1Click returns 401 and Veilroll says so on screen.
# Server-side only: this value is never sent to the browser.
# INTENTS_API_KEY=
